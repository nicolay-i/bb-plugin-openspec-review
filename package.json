{
  "name": "bb-plugin-openspec-review",
  "version": "0.1.0",
  "description": "Browse OpenSpec specs and changes in BB and review their Markdown with comments sent to the agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolay-i/bb-plugin-openspec-review.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:contract": "bun run tests/openspec-contract.ts",
    "test:workspace": "bun run tests/workspace.ts",
    "test:store": "bun build tests/store.ts --target=node --packages=external --outfile=.tmp/tests/store.mjs && node .tmp/tests/store.mjs",
    "test:backend": "bun build tests/server.ts --target=node --packages=external --outfile=.tmp/tests/server.mjs && node .tmp/tests/server.mjs",
    "test:selection": "bun run tests/selection-position.ts",
    "test:progress": "bun run tests/progress.ts",
    "test:live": "bun run tests/live-request.ts",
    "test:quotes": "bun run tests/quote-match.ts",
    "test:spec": "bun run tests/spec-parse.ts",
    "test:windows-cli": "bun build tests/windows-cli.ts --target=node --packages=external --outfile=.tmp/tests/windows-cli.mjs && node .tmp/tests/windows-cli.mjs",
    "test:host": "bun build tests/host.ts --target=node --packages=external --outfile=.tmp/tests/host.mjs && node .tmp/tests/host.mjs",
    "test": "bun run test:contract && bun run test:workspace && bun run test:store && bun run test:backend && bun run test:selection && bun run test:progress && bun run test:live && bun run test:quotes && bun run test:spec && bun run test:host && bun run test:windows-cli",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.79"
  },
  "bb": {
    "name": "OpenSpec Review",
    "description": "Browse OpenSpec specs and changes and review their Markdown with comments sent to the agent.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  }
}
